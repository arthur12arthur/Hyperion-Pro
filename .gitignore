# ============================================================
# HYPERION PRO v1 — .gitignore
# ============================================================

# --- Secrets & Config sensible ---
.env
*.env
config/secrets.yaml
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/

# --- Environnements virtuels ---
venv/
env/
.venv/
.env/

# --- Données brutes & PDFs ---
data/raw/
data/processed/
data/embeddings/
*.pdf

# --- Modèles ML sauvegardés ---
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt

# --- Logs ---
logs/
*.log

# --- Rapports générés ---
reports/

# --- Notebooks checkpoints ---
.ipynb_checkpoints/
notebooks/**/.ipynb_checkpoints/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db
